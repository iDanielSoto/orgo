{
  "name": "@forma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "test": "dotenv -e .env.test -- sh -c 'prisma migrate deploy && vitest run'",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "start:prod": "prisma migrate deploy && node dist/seed.js --if-configured && node dist/server.js"
  },
  "dependencies": {
    "@forma/core": "workspace:*",
    "@prisma/client": "6.19.3",
    "@upstash/qstash": "2.12.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
