# Conexión a PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/forma?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/forma?schema=public"
# Puerto del servidor
PORT=4000
# Orígenes permitidos (separados por coma). En producción, la URL del frontend.
CORS_ORIGINS="http://localhost:5173"
# Permitir crear cuentas nuevas desde /registro (true/false)
ALLOW_REGISTRATION=false
# development | production
NODE_ENV=development
# Credenciales iniciales que usa el seed para crear tu usuario (solo la primera vez)
SEED_USER_EMAIL="tu-correo@ejemplo.com"
SEED_USER_PASSWORD="cambia-esta-contraseña"
SEED_USER_NAME="Daniel"
# Notificaciones push (Web Push). Genera las llaves con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@ejemplo.com"
# Disparador de recordatorios en producción (QStash) o secreto compartido
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
CRON_SECRET=""
